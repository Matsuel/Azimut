# Copie ce fichier en .env puis remplace les valeurs marquées « à changer ». Schéma : env.ts et packages/kafka/src/config/kafka.config.ts

# PostgreSQL du docker-compose (base « notifications », distincte de « trading »)
DATABASE_URL=postgresql://trading:trading@localhost:5432/notifications

# Kafka du docker-compose (listener hôte)
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=notification-service

# 16 caractères minimum, la même valeur dans core-backend (à changer)
INTERNAL_API_KEY=

# Facultatif (valeur par défaut ci-dessous)
PORT=8002
